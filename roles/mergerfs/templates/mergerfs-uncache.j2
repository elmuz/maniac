#!/usr/bin/python3
import argparse
import os
import shutil
import subprocess
import socket
import syslog
import time
import urllib.request
from pathlib import Path
from typing import List


def ping_failure(healthchecks_url: str) -> None:
    """Best-effort Healthchecks /fail ping; never masks the real error."""
    if not healthchecks_url:
        return
    try:
        urllib.request.urlopen(healthchecks_url.rstrip("/") + "/fail", timeout=3)
    except (socket.error, OSError):
        pass

if __name__ == "__main__":
    """
    Uncaching utility. This scripts assumes that you have a cache-like
    mount point, for which you want to preserve a certain amount of free
    space by moving heavy/rarely-accessed files to a slower mount point.

    The script, in its simplest form, can be run as:

    ::

        $ ./mergerfs-uncache.py -s /mnt/cache -d /mnt/slow -t 75

    In this way least accessed files will be moved one after the other
    until the percentage of used capacity will be less than the target.
    Other options are also available. Please consider this is a work in
    progress.
    """

    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-s",
        "--source",
        dest="source",
        type=Path,
        help="Source path (i.e. cache pool root path.",
    )
    parser.add_argument(
        "-d",
        "--destination",
        dest="destination",
        type=Path,
        help="Destination path (i.e. slow pool root path.",
    )
    parser.add_argument(
        "--num-files",
        dest="num_files",
        default=-1,
        type=int,
        help="Maximum number of files moved away from cache.",
    )
    parser.add_argument(
        "--time-limit",
        dest="time_limit",
        default=-1,
        type=int,
        help="Time limit for the whole process (in seconds). Once reached program exits.",
    )
    parser.add_argument(
        "-t",
        "--target",
        dest="target",
        type=float,
        help="Desired max cache usage, in percentage (e.g. 70).",
    )
    parser.add_argument(
        "--exclude",
        dest="exclude",
        nargs="*",
        help="Optional list of absolute paths to be excluded from uncaching operations.",
        required=False,
        default=list(),
    )
    parser.add_argument(
        "--min-age-hours",
        dest="min_age_hours",
        type=float,
        default=24.0,
        help="Skip files modified or accessed within this many hours (default: 24).",
    )
    parser.add_argument(
        "--healthchecks-url",
        dest="hc_url",
        type=str,
        help="Optional URL of the HealthChecks job. If provided, both start and stop ping will be sent.",
        required=False,
        default="",
    )
    parser.add_argument(
        "-v", "--verbose", help="Increase output verbosity.", action="store_true"
    )
    args = parser.parse_args()

    # Some general checks. The mount checks matter: an unmounted mount point
    # still exists as a directory on the root filesystem, so a plain is_dir()
    # check would happily copy data there and --remove-source-files would then
    # delete it from the cache.
    cache_path: Path = args.source
    if not cache_path.is_dir():
        raise NotADirectoryError(f"{cache_path} is not a valid directory.")
    if not os.path.ismount(cache_path):
        raise NotADirectoryError(f"{cache_path} is not a mount point.")
    slow_path: Path = args.destination
    if not slow_path.is_dir():
        raise NotADirectoryError(f"{slow_path} is not a valid directory.")
    if not os.path.ismount(slow_path):
        raise NotADirectoryError(f"{slow_path} is not a mount point.")

    if args.min_age_hours < 0:
        raise ValueError(
            f"Minimum age must be non-negative. Found {args.min_age_hours} instead."
        )

    excluded_paths: List[str] = args.exclude

    last_id = args.num_files
    time_limit = args.time_limit

    target = float(args.target)
    if target <= 1 or target >= 100:
        raise ValueError(
            f"Target value is in percentage, i.e. in the range of (0, 100). Found {target} instead."
        )

    ###################
    # Start the process
    ###################

    if args.hc_url != "":
        try:
            urllib.request.urlopen(args.hc_url + "/start", timeout=3)
        except socket.error as e:
            syslog.syslog(syslog.LOG_ERR, f"Failed to open {args.hc_url}.")

    cache_stats = shutil.disk_usage(cache_path)

    usage_percentage = 100 * cache_stats.used / cache_stats.total
    syslog.syslog(
        syslog.LOG_INFO,
        f"Uncaching from {cache_path} ({usage_percentage:.2f}% used) to {slow_path}.",
    )
    if usage_percentage <= target:
        syslog.syslog(
            syslog.LOG_INFO,
            f"Target of {target}% of used capacity already reached. Exiting.",
        )
        if args.hc_url != "":
            try:
                urllib.request.urlopen(args.hc_url, timeout=3)
            except socket.error as e:
                syslog.syslog(syslog.LOG_ERR, f"Failed to open {args.hc_url}.")
        exit(0)

    min_age_seconds = args.min_age_hours * 3600
    syslog.syslog(
        syslog.LOG_INFO,
        f"Computing candidates (skipping files touched in the last {args.min_age_hours:g} h)...",
    )
    now = time.time()
    candidates = []
    for candidate in cache_path.glob("**/*"):
        try:
            if not candidate.is_file():
                continue
            candidate_stat = candidate.stat()
        except OSError as exc:
            syslog.syslog(syslog.LOG_WARNING, f"Cannot stat {candidate}: {exc}")
            continue
        # Do not move a file that a downloader is still writing or seeding:
        # --remove-source-files would pull the path out from under it.
        if now - max(candidate_stat.st_mtime, candidate_stat.st_atime) < min_age_seconds:
            continue
        candidates.append((candidate, candidate_stat))
    candidates.sort(key=lambda p: p[1].st_atime)

    t_start = time.monotonic()
    syslog.syslog(syslog.LOG_INFO, "Processing candidates...")
    cache_used = cache_stats.used
    for c_id, (c_path, c_stat) in enumerate(candidates):
        skip = False
        for excluded_path in excluded_paths:
            if f"{c_path}".startswith(excluded_path):
                syslog.syslog(
                    syslog.LOG_DEBUG,
                    f"Skipping {c_path} since it is excluded by {excluded_path}.",
                )
                skip = True
                break
        if skip:
            continue
        syslog.syslog(syslog.LOG_DEBUG, f"{c_path}")

        if not c_path.exists():
            # Since rsync moves also other hard links it might be that
            # some files are not existing anymore. However, invoking rsync
            # for each file (instead of directories) does not preserve
            # hard links.
            syslog.syslog(syslog.LOG_WARNING, f"{c_path} does not exist.")
            continue

        # Rsync options
        # -a, --archive               archive mode; equals -rlptgoD (no -H,-A,-X)
        # -x, --one-file-system       don't cross filesystem boundaries
        # -q, --quiet                 suppress non-error messages
        # -H, --hard-links            preserve hard links
        # -A, --acls                  preserve ACLs (implies --perms)
        # -X, --xattrs                preserve extended attributes
        # -W, --whole-file            copy files whole (without delta-xfer algorithm)
        # -E, --executability         preserve the file's executability
        # -S, --sparse                turn sequences of nulls into sparse blocks
        # -R, --relative              use relative path names
        # --preallocate               allocate dest files before writing them
        # --remove-source-files       sender removes synchronized files (non-dirs)
        result = subprocess.run(
            [
                "rsync",
                "-axqHAXWESR",
                "--preallocate",
                "--remove-source-files",
                f"{cache_path}/./{c_path.relative_to(cache_path)}",
                f"{slow_path}/",
            ],
            check=False,
        )
        if result.returncode != 0:
            syslog.syslog(
                syslog.LOG_ERR,
                f"rsync failed for {c_path} with exit code {result.returncode}. Aborting.",
            )
            ping_failure(args.hc_url)
            raise SystemExit(result.returncode)
        cache_used -= c_stat.st_size

        # Evaluate early breaking conditions
        if last_id >= 0 and c_id >= last_id - 1:
            syslog.syslog(
                syslog.LOG_INFO, f"Maximum number of moved files reached ({last_id})."
            )
            break
        if 0 <= time_limit < time.monotonic() - t_start:
            syslog.syslog(
                syslog.LOG_INFO, f"Time limit reached ({time_limit} seconds)."
            )
            break
        if (100 * cache_used / cache_stats.total) <= target:
            syslog.syslog(
                syslog.LOG_INFO, f"Target of maximum used capacity reached ({target})."
            )
            break

    cache_stats = shutil.disk_usage(cache_path)
    usage_percentage = 100 * cache_stats.used / cache_stats.total
    syslog.syslog(
        syslog.LOG_INFO,
        f"Process completed in {round(time.monotonic() - t_start)} seconds. "
        f"Current usage percentage is {usage_percentage:.2f}%.",
    )

    if args.hc_url != "":
        try:
            urllib.request.urlopen(args.hc_url, timeout=3)
        except socket.error as e:
            syslog.syslog(syslog.LOG_ERR, f"Failed to open {args.hc_url}.")
